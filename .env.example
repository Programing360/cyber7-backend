PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp Business API (Meta Developer App Credentials)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0

# Platform System User Access Token (used for backend health checks and integration scripts; never replaces tenant tokens)
META_SYSTEM_USER_ACCESS_TOKEN=

# Webhook Verification Secret (chosen by you and entered in Meta Developer Dashboard)
META_WEBHOOK_VERIFY_TOKEN=

# Internal Webhook Micro-Ingress Mutual HMAC Secret (Step 45A)
INTERNAL_WEBHOOK_SECRET=

# WhatsApp Token Encryption (32-byte Base64 key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
WHATSAPP_ENCRYPTION_KEY=

# Optional Test and Verification Script Variables (for test-meta-integration.ts)
TEST_WABA_ID=
TEST_PHONE_NUMBER_ID=
TEST_RECIPIENT_PHONE=
ENABLE_TEST_MESSAGE_SEND=false

# Public Webhook / API URL for Meta Callbacks (Must be public HTTPS; localhost is not supported by Meta)
# Prefer explicit full webhook URL (e.g. https://api.yourdomain.com/api/whatsapp/webhook or ngrok https URL)
WEBHOOK_PUBLIC_URL=
# Or base API URL (e.g. https://api.yourdomain.com)
PUBLIC_API_URL=

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Campaign Execution
CAMPAIGN_EXECUTION_ENABLED=false
CAMPAIGN_SCHEDULER_INTERVAL_MS=15000
CAMPAIGN_PAGE_SIZE=100
CAMPAIGN_SEND_CONCURRENCY=5
CAMPAIGN_DISPATCH_CONCURRENCY=2

# Campaign Retry
CAMPAIGN_MAX_ATTEMPTS=3
CAMPAIGN_RETRY_DELAY_MS=5000

# Campaign Lease
CAMPAIGN_LEASE_DURATION_MS=60000
CAMPAIGN_HEARTBEAT_INTERVAL_MS=15000

# Worker Shutdown
CAMPAIGN_WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Platform Admin Session Configuration (Phase 02B.5.1)
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=15
ADMIN_SESSION_ABSOLUTE_LIFETIME_HOURS=8
ADMIN_SESSION_COOKIE_NAME=__Host-vexchat_admin_session
ADMIN_SESSION_HEADER_NAME=x-admin-session-token
ADMIN_REQUIRE_EMAIL_VERIFIED=false

# Platform Admin Multi-Factor Authentication (Phase 02B.5.2)
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_MFA_STEP_SECONDS=30
ADMIN_MFA_DRIFT_WINDOWS=1
ADMIN_MFA_ISSUER=VexChat Platform
ADMIN_MFA_ENROLLMENT_EXPIRY_SECONDS=900

# Platform Admin Backend-for-Frontend (BFF) Security (Phase 02B.5.3)
ADMIN_BFF_SECRET=
ADMIN_BFF_ISSUER=vexchat-bff
ADMIN_BFF_AUDIENCE=vexchat-backend
ADMIN_BFF_MAX_AGE_SECONDS=60
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_BOOTSTRAP_SECRET=


