PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp Business API
# Generate a secure 32-byte Base64 key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_ENCRYPTION_KEY=

# A random secret you choose and configure in Meta's Developer Console
WHATSAPP_WEBHOOK_VERIFY_TOKEN=